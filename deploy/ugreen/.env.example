# Copy to .env and keep that file private. Generate your own bootstrap token:
# openssl rand -hex 32
ASSET_BOOTSTRAP_TOKEN=
# Default deployment: loopback, for an existing HTTPS reverse proxy.
ASSET_BIND_ADDRESS=127.0.0.1
ASSET_ALLOWED_ORIGINS=
ASSET_ALLOW_DESKTOP=0
# Only compose.nas-lan.yaml uses these. Fill your actual private LAN IPv4 address.
NAS_IP=
NAS_PORT=8789
